{
  "name": "manual-approval-action",
  "version": "1.1.0",
  "private": false,
  "description": "Manual Approval GitHub Action",
  "keywords": [
    "actions"
  ],
  "homepage": "https://github.com/akefirad/manual-approval-action",
  "bugs": {
    "url": "https://github.com/akefirad/manual-approval-action/issues"
  },
  "license": "MIT",
  "author": "Rad Akefirad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akefirad/manual-approval-action.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "wireit",
    "format": "wireit",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "pre-push": "wireit",
    "prepare": "is-ci || husky",
    "test": "wireit",
    "test:int": "act -s INTEGRATION_TEST_APPROVER_TOKEN=$(gh auth token) -j int-tests"
  },
  "wireit": {
    "format": {
      "command": "oxfmt",
      "files": [
        "**/*.ts",
        "**/*.json"
      ]
    },
    "build": {
      "command": "npm run package",
      "dependencies": [
        "format"
      ]
    },
    "pre-push": {
      "dependencies": [
        "lint",
        "format:check",
        "check:package"
      ]
    },
    "coverage": {
      "command": "npx make-coverage-badge --output-path ./badges/coverage.svg",
      "dependencies": [
        "test"
      ]
    },
    "check:package": {
      "command": "test -z \"$(git status --porcelain)\"",
      "dependencies": [
        "package"
      ]
    },
    "test": {
      "command": "npx vitest run",
      "env": {
        "NODE_NO_WARNINGS": "1"
      }
    }
  },
  "dependencies": {
    "@actions/core": "^1.0.0",
    "@actions/github": "^6.0.0",
    "effect": "^3.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.26.0",
    "@github/local-action": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "husky": "^9.0.0",
    "is-ci": "^4.0.0",
    "make-coverage-badge": "^1.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.0.0",
    "rollup": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wireit": "^0.14.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "oxfmt": {
      "vite-plus": "-"
    },
    "oxlint": {
      "vite-plus": "-"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
