{
  "name": "manual-approval-action",
  "version": "1.1.0",
  "private": false,
  "description": "Manual Approval GitHub Action",
  "keywords": [
    "actions"
  ],
  "homepage": "https://github.com/akefirad/manual-approval-action",
  "bugs": {
    "url": "https://github.com/akefirad/manual-approval-action/issues"
  },
  "license": "MIT",
  "author": "Rad Akefirad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akefirad/manual-approval-action.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run format && npm run package",
    "check:package": "npm run package && test -z \"$(git status --porcelain)\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "pre-push": "npm run lint && npm run format:check && npm run check:package",
    "prepare": "is-ci || husky",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "test:int": "act -s INTEGRATION_TEST_APPROVER_TOKEN=$(gh auth token) -j int-tests"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "effect": "^3.20.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@github/local-action": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "husky": "^9.0.0",
    "is-ci": "^4.0.0",
    "make-coverage-badge": "^1.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.0.0",
    "rollup": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "oxfmt": {
      "vite-plus": "-"
    },
    "oxlint": {
      "vite-plus": "-"
    },
    "undici": "^6.28.0"
  },
  "engines": {
    "node": ">=24"
  }
}
